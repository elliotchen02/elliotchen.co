---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title="About" description="A little about Elliot Chen.">
  <section class="about">
    <h1>About</h1>
    <div class="about-copy">
      <p>
        I'm currently living in San Francisco and working as a software engineer at Applied Intuition.
        I focus on cloud infrastructure, and I'm helping build Applied Intuition’s
        flagship autonomy tools for the government.
        I graduated from MIT with a B.S. in computer science and engineering.
      </p>
      <p>
        With more AI slop out there, I think favorite media is good tell of character,
        so I’ve compiled some of mine on this site.
      </p>
      <p>
        If you'd like to contact me, I'm most reachable by email at
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: var(--reading-width);
  }

  .about h1 {
    margin-bottom: 2.25rem;
  }

  .about-copy {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .about-copy p + p {
    margin-top: 1.4rem;
  }

  .about-copy p {
    color: var(--text-secondary);
  }

  .about-copy a {
    text-decoration: underline;
    text-decoration-color: var(--border-hover);
    text-underline-offset: 0.2em;
  }
</style>
