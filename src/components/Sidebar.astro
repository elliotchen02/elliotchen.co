---
import { SITE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'About' },
  { href: '/books/', label: 'Books' },
  { href: '/music/', label: 'Music' },
];
---

<aside class="sidebar">
  <a class="identity" href="/" aria-label={`${SITE.name}, home`}>
    <img src="/assets/pics/headshot.jpeg" alt="" width="48" height="48" />
    <span>{SITE.name}</span>
  </a>

  <nav class="navigation" aria-label="Main navigation">
    {links.map(({ href, label }) => {
      const active = (href.replace(/\/$/, '') || '/') === pathname;
      return <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>;
    })}
    <a href={SITE.cv} target="_blank" rel="noopener">CV<span class="visually-hidden"> (opens in a new tab)</span></a>
  </nav>

  <div class="sidebar-links">
    <SocialLinks size={18} showCv={false} />
  </div>
</aside>

<style>
  .sidebar {
    align-self: start;
    position: sticky;
    top: 4rem;
    padding-right: 1.75rem;
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    color: var(--text);
    font-size: 1.125rem;
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .identity img {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    object-fit: cover;
  }

  .navigation {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    margin-top: 1.75rem;
  }

  .navigation a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding-block: 0.4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .navigation a:hover,
  .navigation a[aria-current='page'] {
    color: var(--text);
  }

  .navigation a[aria-current='page'] {
    font-weight: 550;
  }

  .sidebar-links {
    margin-top: 1.5rem;
    margin-left: -0.5rem;
  }

  @media (max-width: 700px) {
    .sidebar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      position: static;
      padding: 0 0 1rem;
      border-bottom: 1px solid var(--border);
    }

    .identity {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      font-size: 1rem;
    }

    .identity img {
      width: 36px;
      height: 36px;
    }

    .navigation {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
      margin-top: 1rem;
    }

    .navigation a {
      min-height: 44px;
    }

    .sidebar-links {
      grid-column: 2;
      grid-row: 1;
      margin: 0 -0.5rem 0 0;
    }
  }
</style>
