---
import { SITE } from '../consts';

interface Props {
  size?: number;
  class?: string;
  showCv?: boolean;
}

const { size = 20, class: className, showCv = true } = Astro.props;
---

<nav class:list={['social-links', className]} aria-label="Social">
  <a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
      ></path>
    </svg>
  </a>
  <a href={`mailto:${SITE.email}`} aria-label="Email">
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
      <path d="m2 7 10 6 10-6"></path>
    </svg>
  </a>
  {showCv && <a href={SITE.cv} target="_blank" rel="noopener" aria-label="CV" class="cv-link">
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <path d="M14 2v6h6"></path>
      <path d="M8 13h8"></path>
      <path d="M8 17h8"></path>
      <path d="M8 9h2"></path>
    </svg>
  </a>}
</nav>

<style>
  .social-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 4px;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .social-links a:hover {
    color: var(--text);
  }

  @media (max-width: 700px) {
    .social-links a {
      width: 44px;
      height: 44px;
    }
  }
</style>
